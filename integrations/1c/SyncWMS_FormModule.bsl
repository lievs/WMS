// SyncWMS_FormModule.bsl — МОДУЛЬ ФОРМЫ внешней обработки SyncWMS.
// Синхронизация WMS -> 1С.
//
// Вся содержательная логика (см. SyncWMS_ObjectModule.bsl — МОДУЛЬ
// ОБЪЕКТА той же обработки) вынесена из формы в объект обработки: так ее
// можно вызвать не только по нажатию кнопки, но и программно — из
// регламентного задания для автоматического запуска по расписанию (см.
// README, раздел "Автоматический запуск синхронизации по расписанию").
// Этот файл — только тонкие обработчики кнопок формы, которые вызывают
// Объект.<Метод>(...) и показывают результат пользователю.
//
// ВАЖНО:
// 1. Токен не хранится в исходнике. Заполните реквизит обработки ТокенWMS
//    (он вводится через форму, но хранится как реквизит самого объекта —
//    поэтому доступен и регламентному заданию, у которого формы нет).
// 2. Документы не проводятся.
// 3. Если строку нельзя однозначно сопоставить с Номенклатурой,
//    документ не записывается и WMS не подтверждается.
// 4. Диагностика пишется в журнал регистрации "ОбменWMS".

&НаКлиенте
Процедура ФормаСинхронизировать(Команда)
	Результат = Объект.СинхронизироватьНаСервере();

	// Сообщить (пишет в панель сообщений, остается видимым) вместо
	// Оповестить (всплывающий тост, легко пропустить, особенно если окно
	// 1С не в фокусе или системные уведомления отключены).
	Сообщить(
		"WMS: " + Результат,
		СтатусСообщения.Важное);
КонецПроцедуры

// Отдельная кнопка не создает и не исправляет документы. Она заново читает
// уже существующие перемещения и поступления в 1С, сравнивает их с текущим
// составом WMS и обновляет отчет «Расхождения WMS и 1С».
&НаКлиенте
Процедура ФормаСверитьДокументы(Команда)
	Результат = Объект.СверитьДокументыНаСервере(ДатаНачалаСверки, ДатаОкончанияСверки);
	Сообщить(
		"WMS: " + Результат,
		СтатусСообщения.Важное);
КонецПроцедуры

// Кнопку "Тестовый прогон" нужно добавить на форму так же, как
// "Синхронизировать" (с этим же обработчиком). Прогоняет ровно тот же
// код, что и настоящая синхронизация, но с заранее заданными
// номенклатурой/штрихкодом/количеством вместо реального ответа WMS —
// без HTTP-запроса и без зависимости от остатков на складе. Удобно,
// чтобы быстро проверять сопоставление и запись документа отдельно от
// самого WMS.
&НаКлиенте
Процедура ФормаТестовыйПрогон(Команда)
	Результат = Объект.ТестовыйПрогонНаСервере();
	Сообщить(
		"Тест: " + Результат,
		СтатусСообщения.Важное);
КонецПроцедуры

// Кнопку "Тестовый прогон возврата" — так же, с этим же обработчиком.
// Отдельно от "Тестового прогона" перемещения, т.к. возврат поставщику
// устроен сложнее (поиск Заказа поставщику + автоопределение операции) и
// именно там чаще всего вылезают особенности конкретной базы — быстрее
// проверять его в Конфигураторе, чем гонять реальную приемку через WMS.
&НаКлиенте
Процедура ФормаТестовыйПрогонВозврата(Команда)
	Результат = Объект.ТестовыйПрогонВозвратаНаСервере();
	Сообщить(
		"Тест возврата: " + Результат,
		СтатусСообщения.Важное);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если ПустаяСтрока(Объект.АдресWMS) Тогда
		Объект.АдресWMS = "https://wms.wmsmeviar.ru";
	КонецЕсли;

	// Реквизиты формы типа «Дата». По умолчанию повторно проверяем только
	// последние 30 дней, но бухгалтер может выбрать любой нужный период.
	Если Не ЗначениеЗаполнено(ДатаНачалаСверки) Тогда
		ДатаНачалаСверки = НачалоДня(ТекущаяДата() - 30 * 24 * 60 * 60);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаОкончанияСверки) Тогда
		ДатаОкончанияСверки = КонецДня(ТекущаяДата());
	КонецЕсли;

	// Токен намеренно не прописываем в исходнике.
	// Он должен находиться в реквизите формы ТокенWMS.

КонецПроцедуры
